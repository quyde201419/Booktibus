<UserControl x:Class="Booktibus.Views.ReaderFavoritesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:Booktibus.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=viewModels:ReaderFavoritesViewModel}"
             d:DesignHeight="700"
             d:DesignWidth="1020">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Padding="28,20,28,24">
        <StackPanel>

            <!-- 1. ISOLATION BY USERID NOTICE BANNER -->
            <Border Style="{StaticResource InfoNotificationBannerStyle}"
                    Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{DynamicResource Str.Fav.SectionTitle}"
                                   Foreground="{StaticResource Brush.PrimaryNavy.Main}"
                                   FontWeight="Bold"
                                   FontSize="13"
                                   Margin="0,0,0,3" />
                        <TextBlock Text="{DynamicResource Str.Fav.IsolationNotice}"
                                   Foreground="{StaticResource Brush.Text.Secondary}"
                                   FontSize="12.5"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="16,0,0,0">
                        <Button Content="{DynamicResource Str.Fav.BtnRefresh}"
                                Style="{StaticResource SecondaryOutlineButtonStyle}"
                                Command="{Binding RefreshCommand}"
                                Margin="0,0,8,0" />
                        <Button Content="{DynamicResource Str.Fav.BtnBrowseCatalog}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Command="{Binding BrowseCatalogCommand}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ERROR BANNER IF ANY -->
            <Border Style="{StaticResource DangerNotificationBannerStyle}"
                    Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}"
                    Margin="0,0,0,16">
                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="{StaticResource Brush.Status.Danger}"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap" />
            </Border>

            <!-- 2. MAIN SPLIT: FAVORITES DATAGRID & SELECTED BOOK DETAILS -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.55*" />
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="1.05*" />
                </Grid.ColumnDefinitions>

                <!-- LEFT: FAVORITE BOOKS LIST -->
                <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}">
                    <StackPanel>
                        <TextBlock Text="{Binding FavoritesCountSummary}"
                                   Style="{StaticResource SectionHeaderTextStyle}"
                                   Margin="0,0,0,12" />

                        <!-- Favorites Table -->
                        <DataGrid ItemsSource="{Binding Favorites}"
                                  SelectedItem="{Binding SelectedFavorite}"
                                  Visibility="{Binding IsFavoritesEmpty, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Invert}"
                                  MinHeight="340">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{DynamicResource Str.Catalog.ColCode}"
                                                    Binding="{Binding Book.BookCode}"
                                                    Width="95" />
                                <DataGridTextColumn Header="{DynamicResource Str.Catalog.ColTitle}"
                                                    Binding="{Binding Book.Title}"
                                                    Width="1.6*" />
                                <DataGridTextColumn Header="{DynamicResource Str.Catalog.ColAuthor}"
                                                    Binding="{Binding Book.Author}"
                                                    Width="1.1*" />
                                <DataGridTextColumn Header="{DynamicResource Str.Catalog.ColCategory}"
                                                    Binding="{Binding Book.Category}"
                                                    Width="120" />
                                <DataGridTextColumn Header="{DynamicResource Str.Catalog.ColAvailability}"
                                                    Binding="{Binding Book.AvailabilityDisplay}"
                                                    Width="135" />
                                <DataGridTextColumn Header="{DynamicResource Str.Fav.ColAddedAt}"
                                                    Binding="{Binding AddedAtDisplay}"
                                                    Width="125" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- Empty State when no favorites yet -->
                        <Border Visibility="{Binding IsFavoritesEmpty, Converter={StaticResource BooleanToVisibilityConverter}}"
                                Background="{StaticResource Brush.Background.App}"
                                BorderBrush="{StaticResource Brush.Border.Subtle}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="30"
                                Margin="0,8,0,0">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="♥"
                                           FontSize="32"
                                           Foreground="{StaticResource Brush.AccentGold.Main}"
                                           HorizontalAlignment="Center"
                                           Margin="0,0,0,8" />
                                <TextBlock Text="{DynamicResource Str.Fav.EmptyStateTitle}"
                                           Style="{StaticResource SectionHeaderTextStyle}"
                                           HorizontalAlignment="Center" />
                                <TextBlock Text="{DynamicResource Str.Fav.EmptyStateDesc}"
                                           Style="{StaticResource BodyTextStyle}"
                                           Foreground="{StaticResource Brush.Text.Secondary}"
                                           TextAlignment="Center"
                                           MaxWidth="440"
                                           Margin="0,4,0,16" />
                                <Button Content="{DynamicResource Str.Fav.BtnBrowseCatalog}"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Command="{Binding BrowseCatalogCommand}"
                                        HorizontalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- RIGHT: SELECTED FAVORITE BOOK DETAILS & REMOVE ACTION -->
                <Border Grid.Column="2"
                        Style="{StaticResource CardBorderStyle}"
                        Visibility="{Binding HasSelectedFavorite, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel DataContext="{Binding SelectedFavorite}">
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0"
                                    Background="{StaticResource Brush.PrimaryNavy.Main}"
                                    CornerRadius="4"
                                    Padding="8,3"
                                    HorizontalAlignment="Left">
                                <TextBlock Text="{Binding Book.BookCode}"
                                           Foreground="{StaticResource Brush.AccentGold.Light}"
                                           FontFamily="{StaticResource Font.Monospace}"
                                           FontSize="11.5"
                                           FontWeight="Bold" />
                            </Border>

                            <Border Grid.Column="1"
                                    Background="{StaticResource Brush.AccentGold.Soft}"
                                    BorderBrush="{StaticResource Brush.AccentGold.Main}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="8,2">
                                <TextBlock Text="{Binding Book.SampleDataBadge}"
                                           Foreground="{StaticResource Brush.PrimaryNavy.Dark}"
                                           FontSize="10"
                                           FontWeight="Bold" />
                            </Border>
                        </Grid>

                        <TextBlock Text="{Binding Book.Title}"
                                   FontFamily="{StaticResource Font.Display}"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource Brush.PrimaryNavy.Main}"
                                   TextWrapping="Wrap"
                                   Margin="0,4,0,4" />

                        <TextBlock Text="{Binding Book.Author}"
                                   FontSize="13.5"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource Brush.AccentTeal.Main}"
                                   Margin="0,0,0,14" />

                        <!-- Remove from Favorites Button -->
                        <Button Content="{DynamicResource Str.Fav.BtnRemoveSelected}"
                                Style="{StaticResource DangerButtonStyle}"
                                Command="{Binding DataContext.RemoveFavoriteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}"
                                HorizontalAlignment="Stretch"
                                Margin="0,0,0,16" />

                        <Border BorderBrush="{StaticResource Brush.Border.Subtle}"
                                BorderThickness="0,1,0,0"
                                Padding="0,12,0,0">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="{DynamicResource Str.Catalog.LblCategory}"
                                               Foreground="{StaticResource Brush.Text.Secondary}"
                                               FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Book.Category}"
                                               Foreground="{StaticResource Brush.Text.Primary}" />
                                </Grid>

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="{DynamicResource Str.Catalog.LblShelf}"
                                               Foreground="{StaticResource Brush.Text.Secondary}"
                                               FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Book.ShelfLocation}"
                                               Foreground="{StaticResource Brush.PrimaryNavy.Main}"
                                               FontWeight="Bold" />
                                </Grid>

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="{DynamicResource Str.Catalog.LblCopies}"
                                               Foreground="{StaticResource Brush.Text.Secondary}"
                                               FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Book.AvailabilityDisplay}"
                                               Foreground="{StaticResource Brush.AccentTeal.Main}"
                                               FontWeight="Bold" />
                                </Grid>

                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="{DynamicResource Str.Fav.ColAddedAt}"
                                               Foreground="{StaticResource Brush.Text.Secondary}"
                                               FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding AddedAtDisplay}"
                                               Foreground="{StaticResource Brush.Text.Primary}" />
                                </Grid>

                                <TextBlock Text="{DynamicResource Str.Catalog.LblDescription}"
                                           Style="{StaticResource FieldLabelTextStyle}" />
                                <Border Background="{StaticResource Brush.Background.App}"
                                        BorderBrush="{StaticResource Brush.Border.Subtle}"
                                        BorderThickness="1"
                                        CornerRadius="5"
                                        Padding="12,10">
                                    <TextBlock Text="{Binding Book.Description}"
                                               Style="{StaticResource BodyTextStyle}"
                                               LineHeight="20" />
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>

        </StackPanel>
    </ScrollViewer>
</UserControl>

