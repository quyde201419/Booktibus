<UserControl x:Class="Booktibus.Views.RevealPasswordBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:converters="clr-namespace:Booktibus.Converters"
             mc:Ignorable="d"
             x:Name="RootControl">
    <UserControl.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>
    <Grid VerticalAlignment="Center">
        <!-- 1. Obscured PasswordBox Mode (Bullets) -->
        <PasswordBox x:Name="InternalPasswordBox"
                     Padding="10,6,38,6"
                     PasswordChanged="InternalPasswordBox_OnPasswordChanged"
                     Visibility="{Binding IsPasswordVisible, ElementName=RootControl, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Invert}" />

        <!-- 2. Plain Text TextBox Mode (Revealed) -->
        <TextBox x:Name="InternalTextBox"
                 Padding="10,6,38,6"
                 TextChanged="InternalTextBox_OnTextChanged"
                 Visibility="{Binding IsPasswordVisible, ElementName=RootControl, Converter={StaticResource BooleanToVisibilityConverter}}" />

        <!-- 3. Eye Show/Hide Toggle Button (Positioned inside right edge) -->
        <Button x:Name="EyeButton"
                Click="EyeButton_OnClick"
                Width="30"
                Height="28"
                Margin="0,0,4,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Focusable="False"
                Cursor="Hand"
                Background="Transparent"
                BorderThickness="0">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            CornerRadius="4"
                            Padding="3">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{DynamicResource Brush.Background.RowHover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Background" Value="{DynamicResource Brush.Background.Disabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>

            <Grid>
                <!-- Eye Open Icon (Visible when password IS HIDDEN -> click to reveal) -->
                <Path Data="M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zm0 12.5c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z"
                      Fill="{DynamicResource Brush.Text.Secondary}"
                      Stretch="Uniform"
                      Width="16" Height="16"
                      ToolTip="{DynamicResource Str.Common.ShowPasswordTooltip}"
                      Visibility="{Binding IsPasswordVisible, ElementName=RootControl, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Invert}" />

                <!-- Eye Slash Icon (Visible when password IS SHOWN -> click to hide) -->
                <Path Data="M12 7c2.76 0 5 2.24 5 5 0 .65-.13 1.26-.36 1.83l2.92 2.92c1.51-1.26 2.7-2.89 3.44-4.75-1.73-4.39-6-7.5-11-7.5-1.4 0-2.74.25-3.98.7l2.16 2.16C10.74 7.13 11.35 7 12 7zM2 4.27l2.28 2.28.46.46C3.08 8.3 1.78 10.02 1 12c1.73 4.39 6 7.5 11 7.5 1.55 0 3.03-.3 4.38-.84l.42.42L19.73 22 21 20.73 3.27 3 2 4.27zM7.53 9.8l1.55 1.55c-.05.21-.08.43-.08.65 0 1.66 1.34 3 3 3 .22 0 .44-.03.65-.08l1.55 1.55c-.67.33-1.41.53-2.2.53-2.76 0-5-2.24-5-5 0-.79.2-1.53.53-2.2zm4.31-.78l3.15 3.15.02-.16c0-1.66-1.34-3-3-3l-.17.01z"
                      Fill="{DynamicResource Brush.PrimaryNavy.Main}"
                      Stretch="Uniform"
                      Width="16" Height="16"
                      ToolTip="{DynamicResource Str.Common.HidePasswordTooltip}"
                      Visibility="{Binding IsPasswordVisible, ElementName=RootControl, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </Grid>
        </Button>
    </Grid>
</UserControl>

