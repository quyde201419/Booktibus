<UserControl x:Class="Booktibus.Views.LibrarianReadersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:Booktibus.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=viewModels:LibrarianReadersViewModel}"
             d:DesignHeight="800"
             d:DesignWidth="1060">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Padding="28,20,28,24">
        <StackPanel>

            <!-- 1. FEEDBACK BANNER -->
            <Border Visibility="{Binding HasFeedback, Converter={StaticResource BooleanToVisibilityConverter}}"
                    Margin="0,0,0,16">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource InfoNotificationBannerStyle}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsFeedbackSuccess}" Value="True">
                                <Setter Property="Background" Value="{StaticResource Brush.Status.SuccessBg}" />
                                <Setter Property="BorderBrush" Value="{StaticResource Brush.Status.Success}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsFeedbackSuccess}" Value="False">
                                <Setter Property="Background" Value="{StaticResource Brush.Status.DangerBg}" />
                                <Setter Property="BorderBrush" Value="{StaticResource Brush.Status.Danger}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="{Binding FeedbackMessage}"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap" />
            </Border>

            <!-- 2. SEARCH & FILTER READERS DIRECTORY CARD -->
            <Border Style="{StaticResource CardBorderStyle}"
                    Margin="0,0,0,18">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="{DynamicResource Str.StaffReader.FilterCardTitle}"
                                   Style="{StaticResource SectionHeaderTextStyle}" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding ReadersCountSummary}"
                                   Foreground="{StaticResource Brush.AccentTeal.Main}"
                                   FontWeight="SemiBold"
                                   FontSize="12.5"
                                   VerticalAlignment="Center" />
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.8*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{DynamicResource Str.StaffReader.KeywordLabel}"
                                       Style="{StaticResource FieldLabelTextStyle}" />
                            <TextBox Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Return" Command="{Binding SearchCommand}" />
                                </TextBox.InputBindings>
                            </TextBox>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="{DynamicResource Str.StaffReader.StatusLabel}"
                                       Style="{StaticResource FieldLabelTextStyle}" />
                            <ComboBox ItemsSource="{Binding StatusFilterOptions}"
                                      SelectedItem="{Binding SelectedStatusFilter}"
                                      DisplayMemberPath="DisplayText" />
                        </StackPanel>

                        <StackPanel Grid.Column="4"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Bottom">
                            <Button Content="{DynamicResource Str.Catalog.BtnSearch}"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Command="{Binding SearchCommand}"
                                    Margin="0,0,8,0" />
                            <Button Content="{DynamicResource Str.Catalog.BtnClear}"
                                    Style="{StaticResource SecondaryOutlineButtonStyle}"
                                    Command="{Binding ClearFiltersCommand}" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 3. MAIN SPLIT: READERS LIST (LEFT) & SELECTED READER PROFILE + BORROW HISTORY (RIGHT) -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.45*" />
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="1.15*" />
                </Grid.ColumnDefinitions>

                <!-- LEFT: READERS DIRECTORY DATAGRID -->
                <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}">
                    <DataGrid ItemsSource="{Binding Readers}"
                              SelectedItem="{Binding SelectedReader}"
                              MinHeight="420">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{DynamicResource Str.StaffReader.ColCardId}"
                                                Binding="{Binding ReaderCardId}"
                                                Width="120" />
                            <DataGridTextColumn Header="{DynamicResource Str.StaffReader.ColUsername}"
                                                Binding="{Binding Username}"
                                                Width="105" />
                            <DataGridTextColumn Header="{DynamicResource Str.StaffReader.ColFullName}"
                                                Binding="{Binding FullName}"
                                                Width="1.3*" />
                            <DataGridTextColumn Header="{DynamicResource Str.StaffReader.ColEmail}"
                                                Binding="{Binding Email}"
                                                Width="1.4*" />
                            <DataGridTextColumn Header="{DynamicResource Str.StaffReader.ColStatus}"
                                                Binding="{Binding AccountStatusDisplay}"
                                                Width="135" />
                            <DataGridTextColumn Header="{DynamicResource Str.StaffReader.ColActiveLoans}"
                                                Binding="{Binding ActiveLoansCount}"
                                                Width="85" />
                            <DataGridTextColumn Header="{DynamicResource Str.StaffReader.ColOverdueLoans}"
                                                Binding="{Binding OverdueLoansCount}"
                                                Width="75" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <!-- RIGHT: SELECTED READER PROFILE & BORROW HISTORY -->
                <StackPanel Grid.Column="2"
                            Visibility="{Binding HasSelectedReader, Converter={StaticResource BooleanToVisibilityConverter}}">

                    <!-- Profile Edit Card -->
                    <Border Style="{StaticResource CardBorderStyle}"
                            Margin="0,0,0,18">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Str.StaffReader.DetailTitle}"
                                       Style="{StaticResource SectionHeaderTextStyle}"
                                       Margin="0,0,0,10" />

                            <Border Background="{StaticResource Brush.PrimaryNavy.Main}"
                                    CornerRadius="6"
                                    Padding="14,10"
                                    Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="{Binding SelectedReader.ReaderCardId}"
                                               Foreground="{StaticResource Brush.AccentGold.Light}"
                                               FontFamily="{StaticResource Font.Monospace}"
                                               FontSize="16"
                                               FontWeight="Bold" />
                                    <TextBlock Foreground="{StaticResource Brush.Text.OnDarkMuted}"
                                               FontSize="12"
                                               Margin="0,2,0,0">
                                        <Run Text="Username: " /><Run Text="{Binding SelectedReader.Username, Mode=OneWay}" FontWeight="Bold" />
                                        <Run Text=" • UserId=" /><Run Text="{Binding SelectedReader.UserId, Mode=OneWay}" />
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="{DynamicResource Str.Profile.LblFullName}"
                                       Style="{StaticResource FieldLabelTextStyle}" />
                            <TextBox Text="{Binding EditFullName, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,0,0,10" />

                            <TextBlock Text="{DynamicResource Str.Profile.LblEmail}"
                                       Style="{StaticResource FieldLabelTextStyle}" />
                            <TextBox Text="{Binding EditEmail, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,0,0,10" />

                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="1*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{DynamicResource Str.Profile.LblPhone}"
                                               Style="{StaticResource FieldLabelTextStyle}" />
                                    <TextBox Text="{Binding EditPhone, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="{DynamicResource Str.StaffReader.EditCardStatusLabel}"
                                               Style="{StaticResource FieldLabelTextStyle}" />
                                    <ComboBox ItemsSource="{Binding MembershipStatusChoices}"
                                              SelectedItem="{Binding SelectedEditMembershipStatus}" />
                                </StackPanel>
                            </Grid>

                            <Button Content="{DynamicResource Str.StaffReader.BtnSaveReader}"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Command="{Binding SaveReaderChangesCommand}"
                                    HorizontalAlignment="Stretch" />
                        </StackPanel>
                    </Border>

                    <!-- Borrowing History of Selected Reader -->
                    <Border Style="{StaticResource CardBorderStyle}">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Str.StaffReader.HistorySectionTitle}"
                                       Style="{StaticResource SectionHeaderTextStyle}"
                                       Margin="0,0,0,10" />

                            <DataGrid ItemsSource="{Binding SelectedReaderBorrowHistory}"
                                      MinHeight="170">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="{DynamicResource Str.Borrow.ColRecordCode}"
                                                        Binding="{Binding RecordCode}"
                                                        Width="105" />
                                    <DataGridTextColumn Header="{DynamicResource Str.Borrow.ColBookTitle}"
                                                        Binding="{Binding BookTitle}"
                                                        Width="1.5*" />
                                    <DataGridTextColumn Header="{DynamicResource Str.Borrow.ColBorrowDate}"
                                                        Binding="{Binding BorrowedDateDisplay}"
                                                        Width="95" />
                                    <DataGridTextColumn Header="{DynamicResource Str.Borrow.ColDueDate}"
                                                        Binding="{Binding DueDateDisplay}"
                                                        Width="95" />
                                    <DataGridTextColumn Header="{DynamicResource Str.Borrow.ColStatus}"
                                                        Binding="{Binding LocalizedStatusDisplay}"
                                                        Width="105" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

        </StackPanel>
    </ScrollViewer>
</UserControl>

