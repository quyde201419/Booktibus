<Window x:Class="Booktibus.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Booktibus"
        xmlns:viewModels="clr-namespace:Booktibus.ViewModels"
        xmlns:views="clr-namespace:Booktibus.Views"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=viewModels:MainViewModel, IsDesignTimeCreatable=True}"
        Title="{DynamicResource Str.WindowTitle}"
        Height="800"
        Width="1300"
        MinHeight="660"
        MinWidth="1040"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Brush.Background.App}"
        FontFamily="{StaticResource Font.Primary}">

    <Window.Resources>
        <!-- ViewModel-to-View DataTemplates for single-window MVVM navigation -->
        <DataTemplate DataType="{x:Type viewModels:DashboardViewModel}">
            <views:DashboardView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type viewModels:BookCatalogViewModel}">
            <views:BookCatalogView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type viewModels:ReaderFavoritesViewModel}">
            <views:ReaderFavoritesView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type viewModels:ReaderBorrowingViewModel}">
            <views:ReaderBorrowingView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type viewModels:ReaderProfileViewModel}">
            <views:ReaderProfileView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type viewModels:LibrarianReadersViewModel}">
            <views:LibrarianReadersView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type viewModels:LibraryReportsViewModel}">
            <views:LibraryReportsView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type viewModels:AdminAccountManagementViewModel}">
            <views:AdminAccountManagementView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type viewModels:FinesViewModel}">
            <views:FinesView />
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <!-- ===================================================================
             1. UNAUTHENTICATED VIEW: LOGIN SCREEN
             =================================================================== -->
        <views:LoginView DataContext="{Binding LoginViewModel}"
                         Visibility="{Binding DataContext.IsAuthenticated, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Invert}" />

        <!-- ===================================================================
             2. AUTHENTICATED WORKSPACE: SIDEBAR + HEADER + PAGE CONTENT
             =================================================================== -->
        <Grid Visibility="{Binding IsAuthenticated, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- LEFT SIDEBAR NAVIGATION -->
            <Border Grid.Column="0" Style="{StaticResource SidebarContainerStyle}" Width="255">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Brand Logo & Title -->
                    <Border Grid.Row="0"
                            BorderBrush="{StaticResource Brush.PrimaryNavy.Hover}"
                            BorderThickness="0,0,0,1"
                            Padding="20,22,20,18">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0"
                                    Width="38"
                                    Height="38"
                                    CornerRadius="6"
                                    Background="{StaticResource Brush.AccentGold.Main}"
                                    Margin="0,0,12,0"
                                    VerticalAlignment="Center">
                                <TextBlock Text="B"
                                           FontFamily="{StaticResource Font.Display}"
                                           FontSize="21"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource Brush.PrimaryNavy.Dark}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{DynamicResource Str.AppBrand}"
                                           Style="{StaticResource BrandDisplayTitleStyle}"
                                           FontSize="20" />
                                <TextBlock Text="{DynamicResource Str.AppTagline}"
                                           Foreground="{StaticResource Brush.Text.OnDarkMuted}"
                                           FontSize="10"
                                           FontWeight="SemiBold"
                                           Margin="0,3,0,0" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Role-Filtered Navigation Menu Items -->
                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Margin="0,14,0,14">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Str.Nav.SectionTitle}"
                                       Foreground="{StaticResource Brush.AccentGold.Main}"
                                       FontSize="10.5"
                                       FontWeight="Bold"
                                       Margin="22,0,16,8" />

                            <ItemsControl ItemsSource="{Binding SidebarItems}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <RadioButton Style="{StaticResource SidebarNavButtonStyle}"
                                                     GroupName="BooktibusSidebarGroup"
                                                     IsChecked="{Binding IsSelected, Mode=OneWay}"
                                                     Visibility="{Binding IsVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                     Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                     CommandParameter="{Binding}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding IconGlyph}"
                                                           Width="22"
                                                           FontSize="14"
                                                           VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding DisplayTitle}"
                                                           VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </RadioButton>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Sidebar Footer -->
                    <Border Grid.Row="2"
                            Background="{StaticResource Brush.PrimaryNavy.Main}"
                            BorderBrush="{StaticResource Brush.PrimaryNavy.Hover}"
                            BorderThickness="0,1,0,0"
                            Padding="18,12">
                        <TextBlock Text="{DynamicResource Str.SidebarFooter}"
                                   Foreground="{StaticResource Brush.Text.OnDarkMuted}"
                                   FontSize="11"
                                   TextWrapping="Wrap" />
                    </Border>
                </Grid>
            </Border>

            <!-- RIGHT MAIN AREA (Header + Dynamic Page Content + Status Bar) -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- TOP HEADER BAR -->
                <Border Grid.Row="0"
                        Background="{StaticResource Brush.Background.Surface}"
                        BorderBrush="{StaticResource Brush.Border.Subtle}"
                        BorderThickness="0,0,0,1"
                        Padding="28,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Current Page Title & Subtitle -->
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="{Binding CurrentPage.PageTitle}"
                                       Style="{StaticResource PageTitleTextStyle}"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding CurrentPage.PageSubtitle}"
                                       Style="{StaticResource CaptionTextStyle}"
                                       Margin="0,3,0,0"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <!-- Right Controls: Language Switcher, Account Profile & Logout -->
                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">

                            <!-- Language Toggle Button -->
                            <Button Content="{DynamicResource Str.SwitchLanguageBtn}"
                                    Style="{StaticResource GoldAccentButtonStyle}"
                                    Command="{Binding ToggleLanguageCommand}"
                                    Margin="0,0,12,0" />

                            <!-- Authenticated Account Profile Pill Button -->
                            <Button Style="{StaticResource SecondaryOutlineButtonStyle}"
                                    Command="{Binding AccountProfileCommand}"
                                    Padding="12,5"
                                    Margin="0,0,10,0">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="28"
                                            Height="28"
                                            CornerRadius="14"
                                            Background="{StaticResource Brush.PrimaryNavy.Main}"
                                            Margin="0,0,9,0"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{Binding CurrentAccountInitials}"
                                                   Foreground="{StaticResource Brush.AccentGold.Light}"
                                                   FontSize="11"
                                                   FontWeight="Bold"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Left">
                                        <TextBlock Text="{Binding CurrentAccountDisplayName}"
                                                   Foreground="{StaticResource Brush.PrimaryNavy.Main}"
                                                   FontSize="12"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding CurrentAccountRoleBadge}"
                                                   Foreground="{StaticResource Brush.AccentTeal.Main}"
                                                   FontSize="9.5"
                                                   FontWeight="Bold" />
                                    </StackPanel>
                                </StackPanel>
                            </Button>

                            <!-- Logout Button -->
                            <Button Content="{DynamicResource Str.Header.LogoutBtn}"
                                    Style="{StaticResource DangerButtonStyle}"
                                    Command="{Binding LogoutCommand}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- DYNAMIC PAGE CONTENT HOST -->
                <ContentControl Grid.Row="1"
                                Content="{Binding CurrentPage}" />

                <!-- BOTTOM STATUS BAR -->
                <Border Grid.Row="2"
                        Background="{StaticResource Brush.Background.Surface}"
                        BorderBrush="{StaticResource Brush.Border.Subtle}"
                        BorderThickness="0,1,0,0"
                        Padding="28,9">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Width="8"
                                Height="8"
                                CornerRadius="4"
                                Background="{StaticResource Brush.AccentTeal.Main}"
                                VerticalAlignment="Center"
                                Margin="0,0,10,0" />

                        <TextBlock Grid.Column="1"
                                   Text="{Binding StatusMessage}"
                                   Foreground="{StaticResource Brush.PrimaryNavy.Main}"
                                   FontSize="12.5"
                                   FontWeight="Medium"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />

                        <TextBlock Grid.Column="2"
                                   Text="{DynamicResource Str.CurrentLangBadge}"
                                   Foreground="{StaticResource Brush.Text.Muted}"
                                   FontSize="11.5"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Margin="16,0,0,0" />
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>

