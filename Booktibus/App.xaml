<Application x:Class="Booktibus.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Booktibus"
             xmlns:converters="clr-namespace:Booktibus.Converters"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- 1. Color Palette & Brushes -->
                <ResourceDictionary Source="Resources/ColorsAndBrushes.xaml" />

                <!-- 2. Typography, Metrics & Shadows -->
                <ResourceDictionary Source="Resources/TypographyAndMetrics.xaml" />

                <!-- 3. Control Styles & Templates -->
                <ResourceDictionary Source="Resources/ControlStyles.xaml" />

                <!-- 4. Active Language Dictionary (Default: Vietnamese) -->
                <ResourceDictionary Source="Resources/Strings.vi.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Global Value Converters -->
            <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        </ResourceDictionary>
    </Application.Resources>
</Application>

